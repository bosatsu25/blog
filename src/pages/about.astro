---
import { withBase } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="About — 仏の道" description="仏の道について、書き手について。">
  <article class="article prose-page">
    <header class="article-header">
      <h1>About</h1>
    </header>

    <div class="prose-page__body">
      <p>I'm Ikesama, a QA Engineer / Software Engineer.</p>

      <p>
        Software quality, test automation, developer tooling, frontend engineering, and personal
        software projects are the areas I mainly work on.
      </p>

      <h2>What I work with</h2>

      <p>
        Java · Python · TypeScript
        <br />
        Karate · Playwright · JUnit
        <br />
        GitHub Actions · Jenkins · Docker
        <br />
        Astro · React
      </p>

      <p>I also build small tools and Minecraft-related software as personal projects.</p>

      <p>
        Find me on
        <a href="https://github.com/bosatsuKing" rel="me noopener noreferrer">
          GitHub
        </a>
        , or return to
        <a href={withBase('/', base)}>仏の道</a>.
      </p>
    </div>
  </article>
</BaseLayout>
