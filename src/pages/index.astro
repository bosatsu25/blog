---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 5);
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">QA Engineer / Software Engineer</p>
    <h1>
      Software quality, automation,
      <br />
      and small tools built carefully.
    </h1>
    <p>テスト自動化、開発者向けツール、フロントエンド、個人開発について書いています。</p>
  </section>

  <section aria-labelledby="recent-writing">
    <div class="section-heading">
      <h2 id="recent-writing">Recent Writing</h2>
      <a href={`${import.meta.env.BASE_URL}writing/`}>All writing →</a>
    </div>
    <PostList posts={posts} />
  </section>
</BaseLayout>
