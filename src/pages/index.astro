---
import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import { withBase } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <section class="home-intro" aria-labelledby="home-heading">
    <p class="eyebrow">仏の道</p>
    <h1 id="home-heading">学びと日々の気づきを、静かに綴る。</h1>
    <p>仏教、暮らし、技術について考えたことを記録しています。</p>
  </section>
  <section class="home-posts" aria-labelledby="posts-heading">
    <h2 id="posts-heading">最近の記事</h2>
    <PostList posts={posts} />
    <p class="archive-link">
      <a href={withBase('/archive/', base)}>記事一覧へ →</a>
    </p>
    <p class="subscribe">
      subscribe via <a href={withBase('/rss.xml', base)}>RSS</a>
    </p>
  </section>
</BaseLayout>
