---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — 仏の道" description="お探しのページは見つかりませんでした。">
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>ページが見つかりません。</h1>
    <p>
      <a href={import.meta.env.BASE_URL}>Homeに戻る →</a>
    </p>
  </section>
</BaseLayout>
