---
import BaseLayout from './BaseLayout.astro';
import { formatBlogDate } from '../lib/date';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  tags?: string[];
}

const { title, description, publishedAt, tags = [] } = Astro.props;
---

<BaseLayout title={`${title} — Ikesama`} description={description}>
  <article class="article">
    <header class="article-header">
      <h1>{title}</h1>
      <time datetime={publishedAt.toISOString()}>{formatBlogDate(publishedAt, 'full')}</time>
      {tags.length > 0 && <p class="tags">{tags.join(' · ')}</p>}
    </header>
    <div class="article-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<script>
  const articleBody = document.querySelector<HTMLElement>('.article-body');

  if (articleBody) {
    const selectionTouchesArticle = (): boolean => {
      const selection = window.getSelection();
      if (!selection || selection.isCollapsed) return false;

      for (let index = 0; index < selection.rangeCount; index += 1) {
        if (selection.getRangeAt(index).intersectsNode(articleBody)) return true;
      }

      return false;
    };

    const targetIsInArticle = (target: EventTarget | null): boolean =>
      target instanceof Node && articleBody.contains(target);

    const preventClipboardAction = (event: ClipboardEvent): void => {
      if (selectionTouchesArticle() || targetIsInArticle(event.target)) {
        event.preventDefault();
      }
    };

    document.addEventListener('copy', preventClipboardAction, true);
    document.addEventListener('cut', preventClipboardAction, true);
    articleBody.addEventListener('contextmenu', (event) => event.preventDefault());
    articleBody.addEventListener('dragstart', (event) => event.preventDefault());

    document.addEventListener(
      'keydown',
      (event) => {
        if (!(event.ctrlKey || event.metaKey) || event.altKey) return;

        const key = event.key.toLowerCase();
        const clipboardShortcut = key === 'c' || key === 'x';
        const printShortcut = key === 'p';
        const articleInteraction = selectionTouchesArticle() || targetIsInArticle(event.target);

        if (articleInteraction && (clipboardShortcut || printShortcut)) {
          event.preventDefault();
        }
      },
      true,
    );
  }
</script>
