---
import Header from '../components/Header.astro';
import { siteConfig, withBase } from '../config/site';
import '../styles/global.scss';

interface Props {
  title?: string;
  description?: string;
}

const { title = siteConfig.name, description = siteConfig.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.name}
      href={withBase('/rss.xml', base)}
    />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg', base)} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png', base)} />
    <title>{title}</title>
    <script is:inline src={withBase('/theme-init.js', base)}></script>
  </head>
  <body>
    <div class="page-shell">
      <Header />
      <main id="main-content" class="content">
        <slot />
      </main>
    </div>
  </body>
</html>
