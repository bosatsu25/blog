---
import Header from '../components/Header.astro';
import { siteConfig, withBase, withoutBase } from '../config/site';
import '../styles/global.scss';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  ogType = 'website',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const routePath = withoutBase(Astro.url.pathname, base);
const canonical = new URL(withBase(routePath, base), Astro.site?.origin ?? Astro.url.origin);
const socialImage = new URL(withBase('/lotus-512.png', base), canonical.origin);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="淡いピンクの蓮の花" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.name}
      href={withBase('/rss.xml', base)}
    />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg', base)} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png', base)} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png', base)} />
    <title>{title}</title>
    <script is:inline src={withBase('/theme-init.js', base)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <div class="page-shell">
      <Header />
      <main id="main-content" class="content" tabindex="-1">
        <slot />
      </main>
    </div>
  </body>
</html>
