---
import { siteConfig, withBase } from '../config/site';
import { ThemeToggle } from './ThemeToggle';

const base = import.meta.env.BASE_URL;
---

<header class="top">
  <a class="site-brand" href={withBase('/', base)} aria-label={`${siteConfig.name} — Home`}>
    <img src={withBase('/lotus-512.png', base)} alt="" width="44" height="44" />
    <span>{siteConfig.name}</span>
  </a>

  <div class="header-actions">
    <nav aria-label="Primary navigation">
      <ul>
        {siteConfig.navigation.map((item) => (
          <li>
            <a href={withBase(item.path, base)}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <ThemeToggle client:load />
  </div>
</header>
