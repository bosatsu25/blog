---
import type { CollectionEntry } from 'astro:content';
import { formatBlogDate } from '../lib/date';

interface Props {
  posts: CollectionEntry<'writing'>[];
}

const { posts } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ul class="post-list">
  {posts.map((post) => (
    <li>
      <time class="post-meta" datetime={post.data.publishedAt.toISOString()}>
        {formatBlogDate(post.data.publishedAt, 'compact')}
      </time>
      <a class="post-link" href={`${base}writing/${post.id}/`}>
        {post.data.title}
      </a>
    </li>
  ))}
</ul>
